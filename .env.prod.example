# Copy to `.env` on the production host and fill in.
# Public hostname will be https://${SUBDOMAIN}.${DOMAIN_NAME}
# Used by docker-compose.prod.yml.

SUBDOMAIN=factorio
DOMAIN_NAME=example.com

# Name of the EXISTING Docker network that Traefik is attached to.
# Find it with: docker network ls
# For a compose-run Traefik it's usually "<its-project-dir>_default"
# (e.g. if the n8n stack lives in /opt/n8n, the network is "n8n_default").
TRAEFIK_NETWORK=n8n_default

# Session signing + Factorio-token encryption keys. Generate ONCE and keep
# stable (rotating them invalidates sessions / stored Factorio tokens):
#   FSM_SECRET_KEY:  python -c "import secrets;print(secrets.token_hex(64))"
#   FSM_TOKEN_KEY:   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# FSM_SECRET_KEY is REQUIRED in production: the backend refuses to start without
# a strong secret rather than sign forgeable sessions with a default key.
FSM_SECRET_KEY=
FSM_TOKEN_KEY=

# Optional: Sentry error-reporting DSN. Leave empty to disable Sentry entirely
# (no DSN is baked into the image).
SENTRY_DSN=

# Optional: Sentry feature-flag CHANGE tracking. When a flag is toggled in
# api_config.ini the backend POSTs a signed event to this webhook so Sentry can
# correlate flag changes with issue spikes. Leave empty to disable.
#   - URL: from Sentry -> Settings -> Feature Flags -> Add Provider -> Generic.
#   - SIGNING_SECRET: generate ONCE (10-64 chars), paste the SAME value into the
#     Sentry "Add Provider" dialog and here:
#       python -c "import secrets;print(secrets.token_hex(32))"
SENTRY_FLAGS_WEBHOOK_URL=
SENTRY_FLAGS_SIGNING_SECRET=

# Service uid/gid the backend runs as (after docker-entrypoint.sh drops root) and
# tags spawned Factorio containers with. One knob for the whole stack: it drives
# the image build args, and must match the ownership of the host data dirs — run
# `FSM_UID=... FSM_GID=... sudo -E ./scripts/setup-host.sh` with the same values.
# Leave at the default 10001 unless the host already reserves that id.
FSM_UID=10001
FSM_GID=10001
